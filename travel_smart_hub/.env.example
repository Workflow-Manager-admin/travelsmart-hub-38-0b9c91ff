# Sambonova AI API integration sample configuration

REACT_APP_SAMBONOVA_API_KEY=your-sambonova-key-here
REACT_APP_SAMBONOVA_MODEL=sambonova/sambocrn-v1-chat
REACT_APP_SAMBONOVA_API_BASE=https://api.sambonova.ai
REACT_APP_SAMBONOVA_API_VERSION=v1
# You may override the chat endpoint; default is "/chat/completions"
# REACT_APP_SAMBONOVA_CHAT_ENDPOINT=/chat/completions

# Mapbox and OpenWeather examples for completeness
REACT_APP_MAPBOX_KEY=your-mapbox-key-here
REACT_APP_OPENWEATHER_KEY=your-openweather-key-here
