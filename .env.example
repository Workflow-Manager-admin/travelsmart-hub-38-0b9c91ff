# TravelSmart Hub API Key Environment Variables

# Uncomment and fill out the API keys before deploying or running locally.
# These variables must be named with REACT_APP_ (required for CRA to expose them).

# Mapbox for interactive maps
REACT_APP_MAPBOX_KEY=your-mapbox-access-token-here
REACT_APP_MAPBOX_STYLE=light-v11

# OpenWeatherMap for live weather (required)
REACT_APP_OPENWEATHER_KEY=your-openweathermap-api-key-here

# Cohere for AI travel assistant (optional)
REACT_APP_COHERE_API_KEY=your-cohere-api-key-here

# Amadeus for itinerary/flight search (optional/for expansion)
REACT_APP_AMADEUS_API_KEY=your-amadeus-api-key-here

# Example for Sambonova, if supported or needed:
# REACT_APP_SAMBONOVA_API_KEY=your-sambonova-key-here
# REACT_APP_SAMBONOVA_MODEL=sambonova/sambocrn-v1-chat
# REACT_APP_SAMBONOVA_API_BASE=https://api.sambonova.ai
# REACT_APP_SAMBONOVA_API_VERSION=v1
# REACT_APP_SAMBONOVA_CHAT_ENDPOINT=/chat/completions

# NOTE:
# Never commit your real .env! This template is for example/reference only.
# See README for secure setup instructions.
